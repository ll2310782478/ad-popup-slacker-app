{
  "name": "ad-popup-slacker",
  "version": "2.0.0",
  "description": "伪装成弹窗广告的摸鱼窗口",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "license": "MIT",
  "keywords": [
    "electron",
    "slacker",
    "boss-key",
    "popup-ad"
  ],
  "author": "你的名字",
  "build": {
    "appId": "io.github.adpopupslacker",
    "productName": "Ad Popup Slacker",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}